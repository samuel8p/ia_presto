MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=BeGo
MONGO_DB_CHAT=chat
MONGO_DB_USERS=users
MONGO_DB_TRANSACTIONS=transactions
MONGO_DB_LOGS=logs
SECRET_KEY=<el-mismo-SECRET_KEY-de-auth-y-transactions>
JWT_ALGORITHM=HS256
# Groq (gratis, sin tarjeta): https://console.groq.com/keys
# Modelos: qwen/qwen3.8-27b (español, rápido), openai/gpt-oss-120b (más razonamiento)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=<tu-api-key-de-groq>
LLM_MODEL=qwen/qwen3.8-27b
# Ollama local (privado): cambiar LLM_BASE_URL=http://127.0.0.1:11434/v1,
# LLM_API_KEY=ollama y LLM_MODEL=qwen2.5:3b-instruct
LLM_TIMEOUT=120
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.3
HISTORY_CONTEXT_MESSAGES=12
HOST=127.0.0.1
PORT=5002
DEBUG=true
